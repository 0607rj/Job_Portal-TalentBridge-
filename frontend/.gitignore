# ===========================
# TalentBridge Frontend
# .gitignore — Safe for GitHub
# ===========================

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment Variables (NEVER commit these) ---
.env
.env.local
.env.development
.env.production
.env.staging
.env.test

# --- Build Output ---
dist/
dist-ssr/
build/

# --- Vite Cache ---
.vite/

# --- OS Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# --- Logs ---
logs/
*.log

# --- IDE / Editor ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
