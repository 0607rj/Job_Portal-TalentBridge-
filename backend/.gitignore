# ===========================
# TalentBridge Backend
# .gitignore — Safe for GitHub
# ===========================

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment Variables (NEVER commit these) ---
.env
.env.local
.env.development
.env.production
.env.staging
.env.test

# --- Build Output ---
dist/
build/

# --- OS Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# --- Logs ---
logs/
*.log

# --- File Uploads (runtime data) ---
uploads/
tmp/

# --- IDE / Editor ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Optional: keep .env.example (template with no real values) ---
# !.env.example
