# ===========================
# TalentBridge — Root
# .gitignore — Safe for GitHub
# ===========================

# --- Dependencies ---
node_modules/
**/node_modules/

# --- Environment Variables (CRITICAL — NEVER commit) ---
.env
**/.env
.env.*
**/.env.*

# --- Build Output ---
dist/
build/
**/dist/
**/build/

# --- OS Files ---
.DS_Store
**/.DS_Store
Thumbs.db
Desktop.ini

# --- Logs ---
*.log
logs/

# --- IDE / Editor ---
.vscode/
.idea/
*.suo
*.sw?

# --- Uploads / Runtime Data ---
uploads/
tmp/
